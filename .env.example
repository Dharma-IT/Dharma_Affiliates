# Browser-safe Supabase project settings (required at Vercel build time)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# Server-only database key
SUPABASE_SECRET_KEY=your-server-only-supabase-secret-key
# Optional: restrict workspace access to selected verified Supabase accounts
# AFFILIATE_ALLOWED_EMAILS=admin@dharma.com,dharmauser@info.com
